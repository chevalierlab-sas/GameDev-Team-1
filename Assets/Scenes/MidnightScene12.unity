  m_Name: 
  m_EditorClassIdentifier: 
  dialogManager: {fileID: 1415868321}
  playerMovement: {fileID: 1272010481}
  dialogLines_ID:
  - '"Huh...? Kenapa gelap sekali...? Apa listriknya mati?"'
  - '"Aku nggak bisa tidur begini. Harus ambil senter di meja dan cek saklar listrik."'
  dialogLines_EN:
  - '"Huh...? Why is it so dark...? Did the power go out?"'
  - "\"I can\u2019t sleep like this. I should grab the flashlight from the table
    and check the breaker.\""
  speakers_ID:
  - Putri
  - Putri
  speakers_EN:
  - Putri
